{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"], // 只有 Node，没有 DOM
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts", 
    "src/main/**/*.ts", 
  ]
}
